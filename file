import click
from scanner import scan_networks
from deauth import perform_deauth
from capture import capture_handshake
from cracker import crack_handshake
import utils

@click.group()
def cli():
    pass

@cli.command()
@click.option('--interface', default="wlan0mon")
@click.option('--duration', default=30)
def scan(interface, duration):
    """Scan networks and devices."""
    if utils.setup_monitor_mode(interface.split('mon')[0]):
        results = scan_networks(interface, duration)
        for net in results:
            print(net)

@cli.command()
@click.option('--target')
@click.option('--ap')
@click.option('--count', default=20)
@click.option('--evasion', default="medium")
def deauth(target, ap, count, evasion):
    """Perform deauth with evasion."""
    perform_deauth("wlan0mon", target, ap, count, evasion)

@cli.command()
@click.option('--bssid')
def capture(bssid):
    """Capture handshake."""
    capture_handshake("wlan0mon", bssid)

@cli.command()
@click.option('--capfile')
def crack(capfile):
    """Crack captured handshake."""
    crack_handshake(capfile)

if __name__ == '__main__':
    cli()
