from scapy.all import sniff, Dot11Beacon, Dot11ProbeResp
import utils

def scan_networks(interface, duration=30):
    """Scan for APs and clients."""
    utils.log_operation("Scan", f"Duration: {duration}s on {interface}")
    networks = []
    
    def packet_handler(pkt):
        if pkt.haslayer(Dot11Beacon) or pkt.haslayer(Dot11ProbeResp):
            bssid = pkt.addr2
            ssid = pkt.info.decode() if pkt.info else "Hidden"
            networks.append({"BSSID": bssid, "SSID": ssid})
    
    sniff(iface=interface, prn=packet_handler, timeout=duration)
    return networks
